FROM node:18-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx/weave.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

# The nginx image has no wget on PATH. Busybox can still request the local page.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
    CMD /bin/busybox wget -q -O /dev/null http://127.0.0.1/ || exit 1
