# Copy to .env on the Azure VM only. Do not commit the filled file.
#   cp env.azure.example .env

# cuweave.com DNS points at this VM. Caddy terminates HTTPS here.
WEAVE_DOMAIN=cuweave.com
REACT_APP_API_URL=https://cuweave.com
KF_CORS_ORIGINS=https://cuweave.com,https://www.cuweave.com

SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-strong-db-password
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Azure OpenAI on this VM. Paste the resource key here. Leave Bedrock off.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://exxondemofdr.cognitiveservices.azure.com/openai/v1
OPENAI_QUERY_MODEL=gpt-5-mini
ONTOLOGY_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_PROVIDER=openai
ONTOLOGY_LLM_PROVIDER=openai
BEDROCK_ENABLED=false
ENABLED_LLM_PROVIDERS=openai
